# GearForge EC312 - Local Environment Variables Template
# Copy this file to .env and replace placeholder secrets before running:
#   docker compose up -d
# NEVER commit .env to Git!

GF_DB_NAME=gearforge_db
GF_DB_USER=gf_user
GF_DB_PASSWORD=change_me_local_db_pass
GF_DB_ROOT_PASSWORD=change_me_local_root_pass

GF_WP_PORT=8080
GF_PMA_PORT=8081

# 64-char hex string (32 bytes) for AES-256-CBC encryption of CCCD/Student Card in /var/www/gf-vault
GF_VAULT_ENCRYPTION_KEY=replace_with_64_hex_chars_aes256_key
GF_VAULT_DIR=/var/www/gf-vault

# Sandbox Payment Gateway Mock/Test Secrets (VNPay / MoMo / Fundiin)
GF_SANDBOX_HMAC_SECRET=replace_with_sandbox_hmac_secret
VNP_TMN_CODE=GEARFORGE_TEST
VNP_HASH_SECRET=replace_with_vnpay_sandbox_secret
MOMO_PARTNER_CODE=GEARFORGE_MOMO_TEST
MOMO_ACCESS_KEY=replace_with_momo_access_key
MOMO_SECRET_KEY=replace_with_momo_secret_key
FUNDIIN_MERCHANT_ID=GEARFORGE_FUNDIIN_TEST
FUNDIIN_SECRET_KEY=replace_with_fundiin_secret_key
